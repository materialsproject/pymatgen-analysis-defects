"key":"xuKLSXvUNa"},{"type":"inlineCode","value":"(band, kpoint, spin)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oYsNYXkiuk"},{"type":"text","value":" indices to the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"F1JmtnL1JO"},{"type":"inlineCode","value":"defect_band","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AilRoQysoa"},{"type":"text","value":" argument of the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KSlrtY2vDu"},{"type":"inlineCode","value":"HarmonicDefect","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fNzVqCDMp5"},{"type":"text","value":" object.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EATlElqmZE"}],"key":"Wz7C8hbo6m"}],"identifier":"photo-conduct-5","html_id":"photo-conduct-5","key":"ogLvfeCTMd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def print_eigs(vr, bwind=5, defect_bands=()):\n    \"\"\"Print the eigenvalues in a small band window around the Fermi level.\n\n    Args:\n        vr (Vasprun): The Vasprun object.\n        bwind (int): The number of bands above and below the Fermi level to print.\n        defect_bands (list): A list of tuples of the form (band index, kpt index, spin index)\n    \"\"\"\n\n    def _get_spin_idx(spin) -> int:\n        if spin == Spin.up:\n            return 0\n        return 1\n\n    occ = vr.eigenvalues[Spin.up][0, :, 1] * -1\n    fermi_idx = bisect.bisect_left(occ, -0.5)\n    output = collections.defaultdict(list)\n    for k, spin_eigs in vr.eigenvalues.items():\n        spin_idx = _get_spin_idx(k)\n        for kpt in range(spin_eigs.shape[0]):\n            for ib in range(fermi_idx - bwind, fermi_idx + bwind):\n                e, _o = spin_eigs[kpt, ib, :]\n                idx = (ib, kpt, spin_idx)\n                e_out = f\"{e:7.4f}*\" if idx in defect_bands else f\"{e:8.5f}\"\n                output[(ib)].append(e_out)\n    print(\"band s=0,k=0  s=0,k=1  s=1,k=0  s=1,k=1\")\n    for ib, eigs in output.items():\n        print(f\"{ib:3d} {' '.join(eigs)}\")\n\n\nprint_eigs(vr=hd0.vrun, defect_bands=hd0.defect_band)","key":"pkDN36iB6a"},{"type":"outputs","id":"kH_epp6Cn2tLvUag-1CZd","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"band s=0,k=0  s=0,k=1  s=1,k=0  s=1,k=1\n134  3.46880  3.77960  3.86670  4.22680\n135  3.58800  4.06530  4.04520  4.26400\n136  3.70270  4.25190  4.62880  4.79700\n137  3.89660  4.28290  4.94740  4.98330\n138  4.11920  4.34290  5.5338*  5.7531*\n139  7.98830  6.26990  8.08180  6.35690\n140  8.71050  8.44200  8.81040  8.53660\n141  8.80880  8.55270  8.86150  8.60610\n142  9.12240  8.76330  9.16820  8.86680\n143  9.12980  9.35840  9.17690  9.36620\n"},"key":"eHqAdmaWIw"}],"key":"uU6IWbPfHV"}],"identifier":"photo-conduct-6","html_id":"photo-conduct-6","key":"wkcoWzYdTh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"From the eigenvalues above, we can see that the isolated defect band is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vxcmmtj5IA"},{"type":"inlineCode","value":"[(138, 0, 1), (138, 1, 1)]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uIA9qJEjev"},{"type":"text","value":" which matches with starred values determined by the data from the inverse participation ratio (IPR) analysis.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ebetu7uQxp"}],"key":"YgCCgssvMe"}],"identifier":"photo-conduct-7","html_id":"photo-conduct-7","key":"kRRvV5RbDL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"