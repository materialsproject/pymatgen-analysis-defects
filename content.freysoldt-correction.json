pe":"text","value":" suggests running ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"BJ2BkHibEN"},{"type":"inlineCode","value":"xmgrace -nxy vline-eV-a#.dat","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Ljw9Dj9AjH"},{"type":"text","value":" for each direction and visually identify the plateaus\nThe ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"gtLOl20cPG"},{"type":"inlineCode","value":"plot_sxd_output","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"U4VeyDvzVb"},{"type":"text","value":" below simulates the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yTKiQrS74v"},{"type":"inlineCode","value":"xmgrace -nxy","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"DYlQHrgIju"},{"type":"text","value":" call and we draw a vertical horizontal line at the automatically determined plateau value to see if they match visually.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"kjZyKleSm0"}],"key":"ENW9cmO0x6"}],"key":"o6TCyhJIHE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_sxd_output(q, direction, C, ax):\n    \"\"\"Read the vline-eV-a#.dat files computed by the `sxdefectalign` program.\n\n    Args:\n        q (int): the charge (electron is negative)\n        direction (int): the direction of the line (0, 1, or 2)\n        C (float): the plateau value for the short-range correction.\n        ax (matplotlib.axes.Axes): the axes to plot on\n    \"\"\"\n    v_line_file = DEFECT_DIR / f\"q={q}/vline-eV-a{direction}.dat\"\n    # split the file into blocks based on the location of the string \"&\"\n    with open(v_line_file) as f:\n        blocks = f.read().split(\"&\")\n\n    # convert each block into a list of lines and convert to a numpy array\n    blocks = [[line.split(\"\\t\") for line in block.splitlines()] for block in blocks]\n    blocks[1].pop(0)  # remove the first line of the second block\n    blocks = [np.array(block, dtype=float) for block in blocks]\n    colors_gen = iter([\"black\", \"red\", \"green\"])\n    legends = iter(\n        [\"long range from model\", \"DFT Locpot diff\", \"short range (not aligned)\"]\n    )\n    for b in blocks:\n        for col in range(1, b.shape[1]):\n            ax.plot(b[:, 0], b[:, col], c=next(colors_gen), label=next(legends))\n\n    ax.axhline(C, color=\"k\", linestyle=\"--\")\n    ax.text(4, C, f\"C={C:0.3f}\", va=\"bottom\")\n    ax.legend()\n\n\ndef comparison_plots(q):\n    \"\"\"\"\"\"\n    _fig, axs = plt.subplots(3, 2, figsize=(15, 15), sharey=True)\n    for direction in range(3):\n        plot_sxd_output(\n            q,\n            direction,\n            freysoldt_results[q].metadata[\"alignments\"][direction],\n            axs[direction, 1],\n        )\n        plot_plnr_avg(\n            freysoldt_results[q].metadata[\"plot_data\"][direction], ax=axs[direction, 0]\n        )\n        axs[direction, 0].set_title(f\"q={q} direction={direction} (Python)\")\n        axs[direction, 1].set_title(f\"q={q} direction={direction} (SXDefectAlign)\")\n        axs[direction, 0].set_xlabel(\"\")\n        axs[direction, 1].set_xlabel(\"\")","key":"eHXoxoIR3w"},{"type":"outputs","id":"KYjSzHLblj1l8EUIGeqYL","children":[],"key":"G6OXU5tCKi"}],"key":"bp6Py2HD9y"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The results from ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fh9F3XRscQ"},{"type":"inlineCode","value":"sxdefectalign","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qwd7uPEoJw"},{"type":"text","value":" are shown in the right column.\nThe peak in the LOCPOT difference corresponds to the position of the defect.\nWe find that in the region furthest away from that peak, the plateau value computed by Python matched the plateau value visually.\nNote that in the case of the Python-only plots the defect position is set to the origin and the different alignment terms are set to zero far from the origin.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JsTBMYQmrz"}],"key":"MQRpjHJ0Cs"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We recommend checking the results of your Freysoldt correction by running something like","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"vdvX2jsNOy"}],"key":"wJuL8f4TtT"},{"type":"code","lang":"python","value":"plot_plnr_avg(\n    result.metadata[\"plot_data\"][0],\n)","position":{"start":{"line":8,"column":1},"end":{"line":12,"column":1}},"key":"WuT5Taxq8f"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"This immediately lets you know that, the defect positions were identified correctly if the LOCPOT diff is peaked at the origin and the curves are relatively flat in the sampling region.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"PZttn4BTcS"}],"key":"OhSSvLH6rE"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Note that in the example here, the simulation cell is far too small for standard defect calculations but the defect finder is still able to find the defect position automatically.  Expect it to behave better in larger simulation cells.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"otKILYkQRn"}],"key":"RVgrZFxxOe"}],"key":"KXtJvLWHl3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"comparison_plots(2)","key":"XFYIoQn